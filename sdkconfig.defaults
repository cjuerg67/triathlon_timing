# Force ESP-IDF to use a 16 MB flash configuration for this project.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Required by espressif USB host VCP C++ components.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Enable USB hub support for CH334F on-board hub.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# This board is ESP32-P4 rev 1.x, so use the <3.0 silicon branch.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Rev <3.0 chips are not guaranteed at 400 MHz; use 360 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Enable Wi-Fi for the transport path on ESP32-P4.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_HOST_WIFI_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=0
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=0
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Use a custom partition table large enough for the application image.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=n
